<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(LatestDotNetCoreForMSBuild)</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>Microsoft.Build.ActionTaskHost.UnitTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\Samples\ActionGraphHelloWorld\HelloWorld.proj"
          Link="TestResources\HelloWorld.proj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Samples\ActionGraphHelloWorld\HelloWorld.csproj"
          Link="TestResources\HelloWorld.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Samples\ActionGraphHelloWorld\Program.cs"
          Link="TestResources\Program.cs" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Shouldly" />
    <ProjectReference Include="..\MSBuild.ActionTaskHost\MSBuild.ActionTaskHost.csproj" />
    <ProjectReference Include="..\Tasks\Microsoft.Build.Tasks.csproj" />
    <ProjectReference Include="..\UnitTests.Shared\Microsoft.Build.UnitTests.Shared.csproj" />
  </ItemGroup>
</Project>
